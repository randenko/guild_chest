{
  "version": "2.0.0",
  "problemMatcher": {
    "base": "$msCompile",
    "pattern": {
      "regexp": "^\\s*(?:\\d{2}:\\d{2}:\\d{2}\\s+\\[[A-Z]{3}\\]\\s+)?(?:\\s*\\d+>)?(\\S.*?)(?:\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\))?\\s*:\\s+(?:(\\S+)\\s+)?((?:fatal +)?error|warning|info)\\s+(\\w+\\d+)?\\s*:\\s*(.*)$",
      "kind": "location",
      "file": 1,
      "location": 2,
      "severity": 4,
      "code": 5,
      "message": 6
    }
  },
  "tasks": [
    {"label": "Setup References", "type": "process", "command": "dotnet", "args": ["run", "--project", "build", "--", "--target", "Setup"], "problemMatcher": []},
    {"label": "Build Debug", "type": "process", "command": "dotnet", "args": ["run", "--project", "build", "--", "--target", "Compile"], "group": {"kind": "build", "isDefault": true}},
    {"label": "Run Tests", "type": "process", "command": "dotnet", "args": ["run", "--project", "build", "--", "--target", "Test"], "group": "test"},
    {"label": "Package Release", "type": "process", "command": "dotnet", "args": ["run", "--project", "build", "--", "--target", "Package"]},
    {"label": "Debug Test Host", "type": "process", "command": "dotnet", "args": ["run", "--project", "build", "--", "--target", "Test"], "options": {"env": {"VSTEST_HOST_DEBUG": "1"}}, "problemMatcher": []}
  ]
}
