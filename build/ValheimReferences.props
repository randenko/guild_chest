<Project>
  <!-- Shared game/loader references for the plugin and optional native fixture. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="BepInEx"><HintPath>$(ModDependenciesDir)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ModDependenciesDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(ValheimManagedDir)/assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ValheimManagedDir)/assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ValheimManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ValheimManagedDir)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckValheimReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ValheimManagedDir)/assembly_valheim.dll')" Text="Valheim assemblies are missing. Run bash scripts/dev.sh setup inside the dev container, or pass -p:ValheimManagedDir=/path/to/Managed." />
    <Error Condition="!Exists('$(ModDependenciesDir)/BepInEx.dll') Or !Exists('$(ModDependenciesDir)/0Harmony.dll')" Text="Loader dependencies are missing. Run bash scripts/dev.sh setup inside the dev container." />
  </Target>
</Project>
