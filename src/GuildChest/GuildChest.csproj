<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net48</TargetFramework></PropertyGroup>
  <Import Project="../../build/ValheimReferences.props" />
  <ItemGroup>
    <ProjectReference Include="../GuildChest.Core/GuildChest.Core.csproj" />
    <Reference Include="Jotunn"><HintPath>$(ModDependenciesDir)/Jotunn.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(ValheimManagedDir)/assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ValheimManagedDir)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ValheimManagedDir)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(ValheimManagedDir)/UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="GenerateGuildChestVersion" BeforeTargets="CoreCompile">
    <PropertyGroup><GuildChestVersionFile>$(IntermediateOutputPath)GuildChestVersion.g.cs</GuildChestVersionFile></PropertyGroup>
    <Error Condition="'$(Version)' == ''" Text="manifest.json must define version_number." />
    <WriteLinesToFile File="$(GuildChestVersionFile)" Lines="namespace GuildChest { internal static class BuildVersion { internal const string Value = &quot;$(Version)&quot;%3B } }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(GuildChestVersionFile)" /></ItemGroup>
  </Target>
  <Target Name="WriteGuildChestBuildReceipt" AfterTargets="Build">
    <GetFileHash Files="$(TargetPath);$(TargetDir)GuildChest.Core.dll" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="GuildChestReleaseFiles" />
    </GetFileHash>
    <WriteLinesToFile File="$(TargetDir)GuildChest.build.xml"
                      Lines="&lt;build version=&quot;$(Version)&quot;&gt;;@(GuildChestReleaseFiles->'&lt;file name=&quot;%(Filename)%(Extension)&quot; hash=&quot;%(FileHash)&quot; /&gt;');&lt;/build&gt;"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ModDependenciesDir)/Jotunn.dll')" Text="Mod dependencies are missing. Run bash scripts/dev.sh setup inside the dev container." />
  </Target>
</Project>
