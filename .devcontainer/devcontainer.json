{
  "name": "Guild Chest",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "runArgs": ["--security-opt", "seccomp=unconfined"],
  "mounts": [
    "source=guild-chest-nuget,target=/home/vscode/.nuget/packages,type=volume",
    "source=guild-chest-gh,target=/home/vscode/.config/gh,type=volume",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind",
    "source=guild-chest-codex-packages,target=/home/vscode/.codex/packages,type=volume",
    "source=guild-chest-codex-daemon,target=/home/vscode/.codex/app-server-daemon,type=volume",
    "source=guild-chest-codex-control,target=/home/vscode/.codex/app-server-control,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csharp"],
      "settings": {
        "dotnet.preferCSharpExtension": true,
        "dotnet.defaultSolution": "GuildChest.sln"
      }
    }
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.config/gh && chmod 700 /home/vscode/.config/gh && dotnet run --project build -- --target Restore",
  "shutdownAction": "stopContainer"
}
